# Copy to .env and adjust. docker compose reads it automatically.

# Host port the web app is published on.
UPLINK_PORT=5090

# Name shown in the app for this server.
SERVER_NAME=Tower

# PostgreSQL connection. host.docker.internal reaches the Unraid host (where your
# postgresql14 container publishes 5432); use the server's LAN IP if you prefer.
# The database is created on first start if the user is allowed to (DB_AUTO_CREATE).
DATABASE_URL=postgres://uplink:change-me@host.docker.internal:5432/uplink
DB_AUTO_CREATE=true

# Behind a reverse proxy (needed for HTTPS and installing the PWA): set to true, a hop
# count, or the proxy's address/subnet so client IPs are read from X-Forwarded-For.
TRUST_PROXY=false

# Extra origins allowed to open WebSockets, comma separated. Only needed if your proxy
# rewrites the Host header, e.g. https://speed.example.com
ALLOWED_ORIGINS=

# Server-side caps on what a client may request.
MAX_TEST_SECONDS=30
MAX_STREAMS=8

# Delete results older than this many days (0 keeps everything).
RETENTION_DAYS=0

# debug | info | warn | error
LOG_LEVEL=info
